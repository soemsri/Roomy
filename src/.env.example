# MASTER_ENCRYPTION_KEY is required to decrypt secrets in the database
# Generate a new Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=your_generated_fernet_key_here

# All other API Keys (LINE, etc.) have been migrated to the Database (system_configs table)
# and are encrypted. They can be managed via Admin Dashboard -> System Settings -> Advanced Settings.

# BASE_URL=https://your-domain.ngrok-free.dev/

GOOGLE_CLIENT_ID=your_google_client_id_here

# Choose database
# DATABASE_URL=sqlite:///src/roomy.db
DATABASE_URL=postgresql://username:password@localhost:5432/roomy
